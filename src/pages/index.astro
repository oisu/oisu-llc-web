---
import Base from '../layouts/Base.astro';
import { COMPANY, CONTACT_FORM_ENDPOINT } from '../config';

/** 強み（コンセプト）。AI ネイティブ × 経験 × ドメイン知識 */
const strengths = [
  {
    no: '01',
    title: 'AIネイティブな開発',
    body: 'ハーネスエンジニアリングの技術により、驚くほど少人数で、速く、質の高いものを届けます。',
  },
  {
    no: '02',
    title: '多様なプロダクト開発実績',
    body: 'SIer・メガベンチャー・大手事業会社、そしてスタートアップの 0→1 まで、さまざまな開発実績があるからこそ、AI を正しい方向へ導けます。',
  },
  {
    no: '03',
    title: '幅広いドメイン知識',
    body: '金融・EC・ゲーム・メディア・医療・フィットネスなど、さまざまな領域における知見があり、経営的な視点も、プロダクトの判断に活かします。',
  },
];

const services = [
  {
    icon: '🚀',
    title: '受託開発',
    body: 'UI/UX・ワイヤーフレームから、Web・モバイルアプリ・バックエンドの開発、リリース後の運用まで。AI 前提の開発で、速く形にします。',
  },
  {
    icon: '🔁',
    title: '開発プロセスの改善',
    body: 'チームの役割分担や、要件定義からレビュー・リリースまでの進め方を見直し、AI 時代に合った開発体制に変えます。',
  },
  {
    icon: '🤖',
    title: 'AI 開発基盤',
    body: 'AI コーディングツールの選定・導入から、ルールやコンテキストの整備、CI との連携まで。AI が力を出せる環境を作ります。',
  },
  {
    icon: '📐',
    title: '設計・技術顧問・PdM',
    body: 'アーキテクチャ・技術選定から、プロダクトマネジメントまで。作る前の判断から相談に乗ります。',
  },
  {
    icon: '🧭',
    title: 'FDE',
    body: 'Forward Deployed Engineer として、お客様のチームや現場に入り込み、課題に合わせて AI を組み込んだ仕組みを作り、定着させます。',
  },
  {
    icon: '💬',
    title: 'DX・AI コンサルティング',
    body: '業務の課題を整理し、デジタル化や AI 活用の進め方を提案します。何を AI に任せ、何を人が決めるかを、一緒に考えます。',
  },
];

const stacks = ['Web', 'iOS・Android', 'フロントエンド', 'バックエンド', 'インフラ', 'UI/UX', '生成 AI', 'AI エージェント', 'Mastra', 'AI チャットボット', 'React', 'React Native', 'Flutter', 'Next.js', 'TypeScript', 'AWS', 'Dify', 'n8n', 'Figma', 'pen.dev', 'Paper', 'Linear', 'Langfuse'];

const requests = [
  '新しいサービス・アプリの立ち上げ（MVP）',
  '開発チームへの AI コーディングの導入',
  '今ある Web・アプリの改善や作り直し',
  '業務のデジタル化（DX）や AI の組み込み',
];

const steps = [
  { title: 'ご相談', body: 'まずはオンラインで、やりたいことや状況を伺います。ご相談は無料です。' },
  { title: '設計', body: '何を AI に任せ、何を人が決めるかを含めて、進め方と見積もりを出します。' },
  { title: '開発', body: 'AI 前提の開発で、短い区切りごとに動くものを見ていただきながら進めます。' },
  { title: 'リリース・運用', body: '公開やストアへの申請、公開後の改善まで続けてお手伝いします。' },
];

/** 実績。icon はプロダクトのアイコン、shot は画面の画像（public/images/works/）。画像を出せない案件は emoji で出す */
type Work = { icon?: string; shot?: string; emoji?: string; shotWhite?: boolean; name: string; company: string; url?: string; body: string; tags: string[] };
const works: Work[] = [
  { icon: '/images/works/pfn-icon.png', shot: '/images/works/pfn-insight-scan.jpg', shotWhite: true, name: 'PreferredAI Insight Scan', company: '株式会社Preferred Networks 様', body: '口コミやアンケートなど大量のテキストから、生成 AI でインサイトを見つけるプロダクトの開発に参加しました。', tags: ['生成 AI', 'Next.js'] },
  { emoji: '🏛️', name: '自治体住民向け AI チャットボット', company: '地方自治体・AI 研究所との共同プロジェクト', body: '大学発の AI 研究所とともに、自治体の住民向けチャットボットを開発しました。PdM として、設計から開発基盤の構築までを担当しました。', tags: ['PdM', '生成 AI', '開発基盤'] },
  { emoji: '🎧', name: 'コールセンター向け AI エージェント', company: 'BtoB SaaS', body: 'AI エージェントによってコールセンターなどの顧客対応業務を支える SaaS を開発しました。マルチテナント、マルチエージェント、MCP といった高度なアーキテクチャを実装しました。', tags: ['AI エージェント', 'Mastra', 'Salesforce'] },
  { icon: '/images/works/honenavi-icon.png', shot: '/images/works/honenavi.jpg', name: 'ほねなびLite', company: '株式会社Curelity', body: '共同創業したスタートアップの CTO として、整形外科医と診療支援アプリを開発しました。日本赤十字社愛知医療センター名古屋第二病院（八事日赤）で実証実験を行いました。', tags: ['React Native', 'Next.js'] },
  { icon: '/images/works/giff-letter.jpg', shot: '/images/works/giff-letter-shot.jpg', name: 'giff letter', company: '株式会社pamxy 様', body: '親しい相手にオンラインギフトを送る iOS・Android アプリの開発をリードしました。100 画面を超える大規模なアプリを、大きなトラブルなくリリースしました。', tags: ['React Native', 'Stripe'] },
  { icon: '/images/works/beatfit.jpg', shot: '/images/works/beatfit-shot.jpg', name: 'BeatFit', company: '株式会社アリストル 様', url: 'https://www.beatfit.jp/b2b/', body: 'オーディオフィットネスアプリを 0→1 で開発し、2 か月で初回リリースしました。Google Play ベスト オブ 2019 に選出され、NTTドコモ・日清食品グループなど、数多くの大手企業に導入されています。', tags: ['React Native', 'Firebase'] },
];

/** メンバーの出身企業。logo が無いものは社名の文字で出す（public/images/logos/） */
const clients: { name: string; logo?: string }[] = [
  { name: 'Fast Retailing', logo: '/images/logos/fastretailing.svg' },
  { name: 'DeNA', logo: '/images/logos/dena.svg' },
  { name: 'KADOKAWA', logo: '/images/logos/kadokawa.png' },
  { name: 'Simplex', logo: '/images/logos/simplex.png' },
];

const company = [
  ['会社名', `${COMPANY.name}（${COMPANY.nameEn}）`],
  ['代表者', COMPANY.representative],
  ['設立', COMPANY.founded],
  ['所在地', `${COMPANY.postalCode} ${COMPANY.address}`],
  ['事業内容', 'Web・モバイルアプリの受託開発\n開発プロセスの改善・AI 開発基盤の構築\n設計の相談・技術顧問・PdM・FDE\nDX・AI コンサルティング\n自社アプリの開発・運営'],
];

/** ソフトウェアの移り変わり。最後が今の段階 */
const formReady = CONTACT_FORM_ENDPOINT !== '';
---

<Base
  title="Oisu LLC | AIネイティブな Web・アプリ開発"
  description="Oisu LLC は、開発のすべてを AI 前提で組み立てている開発会社です。コーディングを AI に任せられるいま、何を作り、どう作るかを決める人間の判断を担います。"
>
  <!-- ヒーロー -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">AI-Native Development</p>
      <h1>
        つくるのは、AI。<br />決めるのは、ヒト。
      </h1>
      <p class="hero-sub">
        <span class="scribble">
          <span class="phrase">AIネイティブ ×</span> <span class="phrase">スタートアップ・新規事業</span>
          <svg viewBox="0 0 300 12" preserveAspectRatio="none" aria-hidden="true">
            <path pathLength="1" d="M2 8 C 60 2, 120 11, 180 6 S 270 3, 298 7" fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round"></path>
          </svg>
        </span>
      </p>
      <div class="hero-lead">
        <p>Oisu LLC では、プロダクト開発のすべてを <span class="phrase"><strong>AI 前提</strong>で組み立てています。</span></p>
        <p>
          コーディングを AI に任せられるようになったいま、大切なのは<br class="pc" /><span class="phrase">何をどう作るかを決める</span><span class="phrase"><strong>ヒトの判断</strong>で、</span><span class="phrase">私たちはそのお手伝いをします。</span>
        </p>
      </div>
      <div class="hero-actions">
        <a class="btn btn-accent" href="#contact">相談する →</a>
        <a class="btn" href="#services">できることを見る</a>
      </div>
    </div>
  </section>

  <!-- コンセプト -->
  <section class="section" id="concept">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Concept</p>
        <h2>
          <span class="phrase">AI に任せるために、</span><br class="pc" /><span class="phrase">AI にはできない仕事を。</span>
        </h2>
      </div>
      <div class="card statement">
        <p>
          <span class="phrase">何を作るべきかを見極め、</span><span class="phrase">AI の力を引き出し、</span><span class="phrase">持続可能な仕組みをつくる。</span>
        </p>
        <p>
          業務フローのシステム化も、使い心地のよい UI/UX も、プロの設計とレビューがあってはじめて、プロダクトとしての形になります。その判断を支えるのは、<strong>長年の経験の蓄積</strong>です。
        </p>
      </div>
      <ol class="values-list">
        {
          strengths.map((v) => (
            <li class="value">
              <span class="value-no">{v.no}</span>
              <div>
                <h4>{v.title}</h4>
                <p>{v.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Build First -->
  <section class="section build" id="build-first">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Build First</p>
        <h2>まず、作ってみる。</h2>
        <p>AI で開発コストが劇的に下がったいま、自社の業務に合うものを、まず自分たちで作ってみること（Build First）が現実的な選択肢になりました。</p>
      </div>
      <div class="build-bridge">
        <p class="build-bridge-lead">
          <span class="phrase">誰でも作れるいま、</span><span class="phrase">その判断に差が出る。</span>
        </p>
        <p>まず作り始めることは、正しい選択です。私たちはその歩みに伴走し、プロの目線で、長く使い続けられる仕組みづくりをお手伝いします。</p>
      </div>
    </div>
  </section>

  <!-- できること -->
  <section class="section alt" id="services">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Services</p>
        <h2>できること</h2>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <article class="card service">
              <span class="service-icon" aria-hidden="true">{s.icon}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
      <div class="stacks">
        <span class="stacks-label">対応実績のある領域・技術スタックなど</span>
        <div class="tags">
          {stacks.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 開発のご相談 -->
  <section class="section" id="development">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Development</p>
        <h2>開発のご相談</h2>
        <p>新しいサービスの立ち上げから、今あるプロダクトや開発チームの改善まで。何を頼むか決まっていなくても、まずは状況をお聞かせください。</p>
      </div>

      <div class="dev-grid">
        <div class="card requests">
          <h3>こんなご相談を受けています</h3>
          <ul>
            {requests.map((r) => <li>{r}</li>)}
          </ul>
        </div>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li class="card step">
                <span class="step-no">{i + 1}</span>
                <div>
                  <h4>{s.title}</h4>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>

      <h3 class="works-title" id="works">自社プロジェクト</h3>
      <a class="card project-link" href="/projects/local-ai/">
        <span class="project-badge">Project</span>
        <span class="project-name">おいすラボ</span>
        <span class="project-body">AI を活用して、観光・地域・お店のアプリをつくり、リリース後の運用まで伴走するプロジェクトです。スタンプラリーや観光アプリのプロトタイプを公開しています。</span>
        <span class="project-more">おいすラボを見る <span aria-hidden="true">→</span></span>
      </a>
      <!-- 行政書士アプリ。紹介動画は flashcards リポジトリの promo/（Remotion）で書き出したもの（540×960） -->
      <a class="card project-link project-app" href="/apps/gyoseishoshi/">
        <span class="project-app-text">
          <span class="project-badge">iOS App</span>
          <span class="project-name"><span class="nowrap">行政書士 |</span> <span class="nowrap">毎日ちょっとドリル</span></span>
          <span class="project-body">行政書士試験の過去問を、◯✕の一問一答でくり返し解く iOS アプリです。苦手な問題だけを出し直し、学習の記録は端末の中に保存します。アカウント登録・広告はありません。無料・近日公開。</span>
          <span class="project-more">サポートページを見る <span aria-hidden="true">→</span></span>
        </span>
        <video
          class="project-app-video"
          src="/projects/gyoseishoshi/promo.mp4"
          poster="/projects/gyoseishoshi/poster.jpg"
          autoplay
          muted
          loop
          playsinline
          aria-label="アプリの紹介動画。◯✕で答えると解説が出て、苦手な問題だけをくり返し、6 つのデザインから選べる様子"
        ></video>
      </a>

      <h3 class="works-title">過去のプロジェクト（一部抜粋）</h3>
      <ul class="works">
        {
          works.map((w) => (
            <li class="card work">
              <div class:list={['work-shot', { 'work-shot-emoji': !w.shot, 'work-shot-white': w.shotWhite }]}>
                {w.shot ? <img src={w.shot} alt={`${w.name}の画面`} loading="lazy" /> : <span aria-hidden="true">{w.emoji}</span>}
              </div>
              <div class="work-main">
                <div class="work-head">
                  {w.icon && <img class="work-icon" src={w.icon} alt="" width="48" height="48" loading="lazy" />}
                  <div>
                    <h4>
                      {w.url ? (
                        <a href={w.url} target="_blank" rel="noopener noreferrer">
                          {w.name}
                        </a>
                      ) : (
                        w.name
                      )}
                    </h4>
                    <p class="work-company">{w.company}</p>
                  </div>
                </div>
                <p>{w.body}</p>
                <div class="tags">
                  {w.tags.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>
            </li>
          ))
        }
      </ul>

      <h3 class="works-title">メンバーの出身企業</h3>
      <ul class="logos">
        {
          clients.map((c) => (
            <li class="logo-card">
              {c.logo ? <img src={c.logo} alt={c.name} loading="lazy" /> : <span class="logo-text">{c.name}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 会社概要 -->
  <section class="section alt" id="company">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Company</p>
        <h2>会社概要</h2>
      </div>
      <dl class="card company">
        {
          company.map(([k, v]) => (
            <div class="company-row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>

      <h3 class="works-title">代表プロフィール</h3>
      <div class="card profile">
        <img class="profile-photo" src="/images/profile/avatar.svg" alt="三浦 宏晃のアバター" width="120" height="120" loading="lazy" />
        <div class="profile-body">
          <div class="profile-head">
            <p class="profile-name">三浦 宏晃<span>Hiroaki Miura</span></p>
            <p class="profile-role">代表 / プロダクトマネージャー / ソフトウェアエンジニア</p>
          </div>
          <p>早稲田大学卒業後、DeNA、KADOKAWA、ファーストリテイリングなどで、ゲーム・メディア・EC のプロダクト開発を経験。2018年に独立し、スタートアップの 0→1 開発に多く携わってきました。</p>
          <p>2021年に Oisu LLC を設立し、2023年には CTO としてスタートアップを共同創業。現在は PdM として、AI を前提とした開発とプロダクトの意思決定を支援しています。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- お問い合わせ -->
  <section class="section" id="contact">
    <div class="container contact">
      <div class="section-head">
        <p class="eyebrow">Contact</p>
        <h2>お問い合わせ</h2>
        <p>開発のご相談・お見積もり・取材など、お気軽にご連絡ください。2 営業日以内にお返事します。</p>
      </div>
      <form class="card form" id="contact-form" action={CONTACT_FORM_ENDPOINT || undefined} method="post">
        <input type="hidden" name="_subject" value="【oisu.jp】お問い合わせ" />
        <!-- 迷惑投稿よけ。人には見えず、ボットが入力すると Formspree が破棄する -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" hidden />
        <label>
          <span>お名前</span>
          <input name="name" autocomplete="name" required />
        </label>
        <label>
          <span>メールアドレス</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>会社名<small>（任意）</small></span>
          <input name="company" autocomplete="organization" />
        </label>
        <label>
          <span>ご相談の内容</span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <p class="note">いただいた情報は、お問い合わせへの返信のためだけに使います。送信することで、<a href="/privacy/">プライバシーポリシー</a>に同意したものとします。</p>
        <button class="btn btn-accent" type="submit" disabled={!formReady}>送信する</button>
        {!formReady && <p class="note">フォームは準備中です。</p>}
        <p class="result" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script>
  // お問い合わせの送信。ページを離れずに送り、結果をフォームの下に出す
  type PostHogClient = {
    capture: (event: string) => void;
    logger?: {
      info: (message: string, attributes?: Record<string, string>) => void;
      warn: (message: string, attributes?: Record<string, string>) => void;
    };
  };

  const getPostHog = () => (window as Window & { posthog?: PostHogClient }).posthog;
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const result = form?.querySelector<HTMLElement>('.result');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.action || !result) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    result.textContent = '送信しています…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      result.textContent = '送信しました。お返事まで少しお待ちください。';
      // 入力内容は送らず、送信できたことだけを記録する
      getPostHog()?.capture('contact_submitted');
      getPostHog()?.logger?.info('contact form submitted', { form: 'contact' });
    } catch {
      getPostHog()?.logger?.warn('contact form submission failed', { form: 'contact' });
      result.textContent = '送信できませんでした。時間をおいて、もう一度お試しください。';
    } finally {
      if (button) button.disabled = false;
    }
  });
</script>

<style>
  .hero {
    padding: 88px 0 96px;
    border-bottom: var(--line);
    background:
      radial-gradient(circle at 1px 1px, rgba(10, 10, 10, 0.12) 1px, transparent 0) 0 0 / 22px 22px,
      var(--bg);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 24px;
  }
  .hero-inner .eyebrow {
    align-self: center;
  }
  .hero h1 {
