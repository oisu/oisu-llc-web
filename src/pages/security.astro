---
import Base from '../layouts/Base.astro';
import { COMPANY } from '../config';

/** 情報セキュリティ基本方針の各項目。社内の文書（docx）と同じ内容にそろえる */
const items = [
  ['経営者の責任', '当社は、経営者主導で組織的かつ継続的に情報セキュリティの改善・向上に努めます。'],
  ['社内体制の整備', '当社は、情報セキュリティの維持及び改善のために必要な体制を整備し、情報セキュリティ対策を社内の正式な規則として定めます。'],
  ['従業員の取組み', '当社の従業員は、情報セキュリティのために必要とされる知識、技術を習得し、情報セキュリティへの取り組みを確かなものにします。'],
  ['法令及び契約上の要求事項の遵守', '当社は、情報セキュリティに関わる法令、規制、規範、契約上の義務を遵守するとともに、お客様の期待に応えます。'],
  ['違反及び事故への対応', '当社は、情報セキュリティに関わる法令違反、契約違反及び事故が発生した場合には適切に対処し、再発防止に努めます。'],
];
---

<Base
  title="情報セキュリティ基本方針 | Oisu LLC"
  description="合同会社おいす（Oisu LLC）の情報セキュリティ基本方針です。"
>
  <section class="section policy-section">
    <div class="container policy">
      <div class="section-head">
        <p class="eyebrow">Security Policy</p>
        <h1>情報セキュリティ基本方針</h1>
      </div>

      <p>
        {COMPANY.name}（以下、当社）は、お客様からお預かりした情報資産および当社の情報資産を事故・災害・犯罪などの脅威から守り、お客様ならびに社会の信頼に応えるべく、以下の方針に基づき全社で情報セキュリティに取り組みます。
      </p>

      {
        items.map(([title, body], i) => (
          <>
            <h2>{i + 1}. {title}</h2>
            <p>{body}</p>
          </>
        ))
      }

      <p class="signature">
        制定日：2026年11月26日<br />
        {COMPANY.name}<br />
        代表社員　{COMPANY.representative}
      </p>

      <div class="badge">
        <a href="https://www.ipa.go.jp/security/security-action/" target="_blank" rel="noopener noreferrer">
          <img src="/images/security-action/futatsuboshi.png" alt="SECURITY ACTION 二つ星 セキュリティ対策自己宣言" width="96" height="96" />
        </a>
        <p>当社は、IPA（独立行政法人情報処理推進機構）が創設した「SECURITY ACTION」の二つ星を宣言しています。</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .policy {
    max-width: 800px;
  }
  .policy h1 {
    font-size: clamp(28px, 5vw, 40px);
  }
  .policy h2 {
    margin: 40px 0 10px;
    font-size: 21px;
    line-height: 1.4;
  }
  .signature {
    margin-top: 44px;
    text-align: right;
    line-height: 1.9;
  }
  .badge {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 44px;
    padding: 20px;
    border: var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .badge a {
    flex-shrink: 0;
    line-height: 0;
  }
  .badge img {
    width: 96px;
    height: 96px;
  }
  .badge p {
    font-size: 15px;
    line-height: 1.7;
  }
  @media (max-width: 560px) {
    .badge {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
