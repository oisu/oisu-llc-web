---
import { NAV } from '../config';
---

<header class="header">
  <div class="container inner">
    <a class="logo" href="/" aria-label="Oisu LLC トップへ">Oisu LLC</a>
    <nav class="nav" aria-label="ページ内のリンク">
      {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <div class="actions">
      <a class="btn btn-accent cta" href="/#contact">相談する</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--surface);
    border-bottom: var(--line);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 72px;
  }
  /* 会社のロゴ。枠や影をつけず、ボタンと見分ける */
  .logo {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    min-height: 44px;
    color: var(--ink);
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  /* メニューは右に寄せ、相談ボタンの隣に置く */
  .nav {
    margin-left: auto;
    display: flex;
    gap: 24px;
    font-weight: 700;
    font-size: 15px;
  }
  .nav a {
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .cta {
    min-height: 44px;
    padding: 0 16px;
  }
  @media (max-width: 820px) {
    .nav {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
  }
  @media (max-width: 400px) {
    .inner {
      gap: 12px;
    }
    .actions {
      gap: 10px;
    }
  }
</style>
