---
import { COMPANY, SOCIALS } from '../config';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <div>
      <p class="name">{COMPANY.name}</p>
      <p class="muted">{COMPANY.postalCode} {COMPANY.address}</p>
    </div>
    <ul class="links">
      {
        SOCIALS.map((s) => (
          <li>
            <a href={s.url} target="_blank" rel="noopener">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="copy">© {year} {COMPANY.nameEn}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--line);
    background: var(--ink);
    color: #f5efe6;
    padding: 40px 0;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px;
  }
  .name {
    font-weight: 900;
    font-size: 18px;
  }
  .muted {
    color: #b8ad9f;
    font-size: 14px;
  }
  .links {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-weight: 700;
  }
  .copy {
    margin-left: auto;
    color: #b8ad9f;
    font-size: 14px;
  }
  @media (max-width: 640px) {
    .copy {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
